# App Settings
APP_NAME=AstroAPI
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=supersecretkeychangemeinproduction
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database (PostgreSQL) Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=astro

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Qdrant Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_USE_SSL=false

# Logging
LOG_LEVEL=INFO
